*.pyc
*.pyo
.venv/
venv/
env/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
dist/
build/

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Local scratch
*.log
